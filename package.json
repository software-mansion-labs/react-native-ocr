{
  "name": "@swmansion/react-native-ocr",
  "version": "0.11.0",
  "description": "Advanced on-device OCR for React Native on top of react-native-executorch: EasyOCR and PaddleOCR detection and recognition, vertical text, document layout, page orientation, dewarping and table structure.",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!cpp/tests",
    "!android/build",
    "!android/.cxx",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-ocr-example",
    "test": "jest",
    "test:native": "scripts/run-native-tests.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "format": "prettier --write .",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it --only-version",
    "docs": "typedoc && node scripts/inject-gtm.js"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "ocr",
    "text-recognition",
    "easyocr",
    "paddleocr",
    "document-layout",
    "executorch",
    "on-device-ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/software-mansion-labs/react-native-ocr.git"
  },
  "author": "Software Mansion <hello@swmansion.com> (https://github.com/software-mansion)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/software-mansion-labs/react-native-ocr/issues"
  },
  "homepage": "https://github.com/software-mansion-labs/react-native-ocr#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "react-native-executorch": {
    "features": [
      "ocr"
    ]
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0",
    "react-native-executorch": ">=0.11.0",
    "react-native-worklets": ">=0.10.0 <0.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.25.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@cspell/eslint-plugin": "^8.19.0",
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@evilmartians/lefthook": "^2.1.1",
    "@react-native/babel-preset": "^0.85.0",
    "@react-native/eslint-config": "^0.85.0",
    "@react-native/jest-preset": "^0.85.0",
    "@react-native/metro-config": "^0.85.0",
    "@release-it/conventional-changelog": "^9.0.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "commitlint": "^19.6.1",
    "cspell": "^8.19.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-ft-flow": "^2.0.3",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-blob-util": "^0.24.11",
    "react-native-builder-bob": "^0.40.18",
    "react-native-executorch": "^0.11.0",
    "react-native-worklets": "0.10.3",
    "release-it": "^17.10.0",
    "typedoc": "^0.28.13",
    "typescript": "~5.9.2"
  },
  "resolutions": {
    "react-native-worklets": "0.10.3"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.0",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RnOcrSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.swmansion.rnocr"
    }
  }
}
